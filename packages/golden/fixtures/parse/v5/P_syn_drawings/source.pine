//@version=5
indicator("P_syn_drawings", overlay = true, max_lines_count = 100, max_labels_count = 100, max_boxes_count = 50)
var tbl = table.new(position.top_right, 2, 2, border_width = 1)
if barstate.islast
    table.cell(tbl, 0, 0, "close", text_color = color.white, bgcolor = color.blue)
    table.cell(tbl, 1, 0, str.tostring(close))
l = line.new(bar_index - 1, low[1], bar_index, low, color = color.red, width = 2, style = line.style_dashed, extend = extend.right)
l2 = line.new(bar_index - 1, high[1], bar_index, high, color = color.blue)
line.set_xy2(l, bar_index, high)
lb = label.new(bar_index, high, "hi", style = label.style_label_down, color = color.green, textcolor = color.white, size = size.small, yloc = yloc.price, xloc = xloc.bar_index)
label.set_text(lb, "high")
label.set_tooltip(lb, "tooltip")
bx = box.new(bar_index - 2, high, bar_index, low, border_color = color.gray, bgcolor = color.new(color.gray, 90))
box.delete(bx[1])
lf = linefill.new(l, l2, color.new(color.blue, 80))
plt = polyline.new(array.from(chart.point.from_index(bar_index - 1, low[1]), chart.point.from_index(bar_index, low)), curved = false)
p1 = plot(high, "h", color.new(color.blue, 0))
p2 = plot(low, "l", color.new(color.red, 0))
fill(p1, p2, color = color.new(color.purple, 90))
bgcolor(close > open ? color.new(color.green, 95) : na)
barcolor(close > open ? color.lime : color.maroon)
hline(0, "zero", color.gray, hline.style_dotted)
plotshape(close > open, "up", shape.triangleup, location.belowbar, color.green)
plotchar(close < open, "dn", "v", location.abovebar, color.red)
plotarrow(close - open, "arrow")
plotcandle(open, high, low, close, "candle", color = color.new(color.blue, 50))
plotbar(open, high, low, close, "bar", color.orange)
line.delete(l[1])
label.delete(lb[1])
