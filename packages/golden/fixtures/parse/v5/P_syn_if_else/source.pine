//@version=5
indicator("P_syn_if_else")
x = if close > open
    1
else if close < open
    -1
else
    0
float y = na
if x > 0
    y := high
else
    y := low
if bar_index % 2 == 0
    if x == 0
        y := hl2
    else
        y := ohlc4
z = if x > 0
    "up"
else
    "down"
plot(x)
plot(y)
plot(str.length(z))
