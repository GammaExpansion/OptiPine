//@version=6
indicator("P_syn_strings")
s = "Hello, Pine Script"
n1 = str.length(s)
b1 = str.contains(s, "Pine")
p1 = str.pos(s, "Pine")
r1 = str.replace(s, "Pine", "Vine", 0)
r2 = str.replace_all(s, "l", "L")
parts = str.split(s, ", ")
sub = str.substring(s, 0, 5)
up = str.upper(s)
lo = str.lower(s)
sw = str.startswith(s, "Hello")
ew = str.endswith(s, "Script")
tr = str.trim("  x  ")
rp = str.repeat("ab", 3)
mt = str.match(s, "[A-Z]\\w+")
f1 = str.format("{0} / {1,number,#.##}", s, close)
f2 = str.format_time(time, "yyyy-MM-dd HH:mm", "UTC")
t1 = str.tostring(close, format.mintick)
t2 = str.tostring(bar_index)
n2 = str.tonumber("3.5")
plot(n1 + p1 + str.length(r1) + str.length(r2) + array.size(parts) + str.length(sub) + str.length(up) + str.length(lo) + (b1 ? 1 : 0) + (sw ? 1 : 0) + (ew ? 1 : 0) + str.length(tr) + str.length(rp) + str.length(mt) + str.length(f1) + str.length(f2) + str.length(t1) + str.length(t2) + n2)
