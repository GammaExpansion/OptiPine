//@version=6
indicator("P_syn_arrays")
var a = array.new_float(0)
array.push(a, close)
if array.size(a) > 50
    array.shift(a)
b = array.from(3.0, 1.0, 2.0)
array.sort(b, order.ascending)
array.unshift(b, 0.0)
array.insert(b, 1, 0.5)
array.remove(b, 0)
array.set(b, 0, 9.0)
c = array.copy(b)
array.reverse(c)
d = array.concat(array.copy(b), c)
e = array.slice(d, 0, 2)
idx = array.indexof(d, 9.0)
has = array.includes(d, 2.0)
s = array.join(array.from("a", "b"), ",")
r = array.range(d)
st = array.stdev(d)
va = array.variance(d)
md = array.median(d)
mo = array.mode(d)
cv = array.covariance(d, d)
bs = array.binary_search(array.from(1.0, 2.0, 3.0), 2.0)
mx = array.max(d)
mn = array.min(d)
sm = array.sum(d)
av = array.avg(d)
f = array.first(d)
l = array.last(d)
array.clear(c)
p = array.pop(array.copy(d))
plot(sm + av + mx + mn + f + l + p + r + st + va + md + mo + cv + bs + idx + (has ? 1 : 0) + str.length(s) + array.size(e) + array.size(a))
