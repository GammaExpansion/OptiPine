//@version=6
indicator("P_syn_inputs_all")
i1 = input(5, "generic int")
i2 = input.int(10, "int", minval = 1, maxval = 100, step = 1, tooltip = "tip", inline = "g1", group = "Group A")
i3 = input.int(3, "int options", options = [1, 3, 5])
f1 = input.float(0.5, "float", minval = 0.0, maxval = 1.0, step = 0.1)
b1 = input.bool(true, "bool", confirm = false)
s1 = input.string("x", "string", options = ["x", "y"])
s2 = input.text_area("multi\nline", "text")
src = input.source(close, "source")
c1 = input.color(color.red, "color")
t1 = input.time(timestamp("2024-01-01T00:00:00"), "time")
p1 = input.price(100.0, "price")
sym = input.symbol("AAPL", "symbol")
tf = input.timeframe("D", "timeframe")
ses = input.session("0930-1600", "session")
d1 = input.int(1, "display", display = display.none)
plot(i1 + i2 + i3 + f1 + (b1 ? 1 : 0) + str.length(s1) + str.length(s2) + src + p1 + str.length(sym) + str.length(tf) + str.length(ses) + d1)
plot(t1)
plot(close, color = c1)
