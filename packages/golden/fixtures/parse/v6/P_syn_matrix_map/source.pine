//@version=6
indicator("P_syn_matrix_map")
m = matrix.new<float>(2, 2, 0.0)
matrix.set(m, 0, 0, 1.0)
matrix.set(m, 1, 1, 2.0)
t = matrix.transpose(m)
rows = matrix.rows(m)
cols = matrix.columns(t)
summed = matrix.sum(m, t)
sm = matrix.get(summed, 0, 0)
av = matrix.avg(m)
g = matrix.get(m, 1, 1)
row0 = matrix.row(m, 0)
mp = map.new<string, float>()
map.put(mp, "close", close)
map.put(mp, "open", open)
v = map.get(mp, "close")
has = map.contains(mp, "open")
ks = map.keys(mp)
vs = map.values(mp)
map.remove(mp, "open")
plot(rows + cols + sm + av + g + array.size(row0) + v + (has ? 1 : 0) + array.size(ks) + array.size(vs) + map.size(mp))
