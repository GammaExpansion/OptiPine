//@version=6
indicator("P_syn_loops")
sum1 = 0.0
for i = 0 to 9
    sum1 += close[i]
sum2 = 0.0
for i = 9 to 0 by -3
    sum2 += close[i]
arr = array.from(1.0, 2.0, 3.0)
sum3 = 0.0
for v in arr
    sum3 += v
sum4 = 0.0
for [i, v] in arr
    sum4 += v * i
n = 0
while n < 5
    n += 1
    if n == 2
        continue
    if n == 4
        break
plot(sum1 + sum2 + sum3 + sum4 + n)
