//@version=5
indicator("I_collections")
plot(bar_index, "bar_index")
var win = array.new_float(0)
array.push(win, close)
if array.size(win) > 20
    array.shift(win)
var win2 = array.new_float(0)
array.push(win2, volume)
if array.size(win2) > 20
    array.shift(win2)
plot(array.size(win), "arr_size")
plot(array.sum(win), "arr_sum")
plot(array.avg(win), "arr_avg")
plot(array.min(win), "arr_min")
plot(array.max(win), "arr_max")
plot(array.stdev(win), "arr_stdev")
plot(array.variance(win), "arr_variance")
plot(array.median(win), "arr_median")
plot(array.range(win), "arr_range")
plot(array.first(win), "arr_first")
plot(array.last(win), "arr_last")
plot(array.get(win, 0), "arr_get0")
sortedDesc = array.copy(win)
array.sort(sortedDesc, order.descending)
plot(array.get(sortedDesc, 0), "arr_sorted_desc0")
asc = array.copy(win)
array.sort(asc)
plot(array.binary_search(asc, close), "arr_bsearch_close")
plot(array.binary_search_leftmost(asc, open), "arr_bsearch_left_open")
plot(array.indexof(win, close), "arr_indexof_close")
plot(array.lastindexof(win, close), "arr_lastindexof_close")
plot(array.includes(win, open) ? 1 : 0, "arr_includes_open")
sl = array.slice(win, 0, math.min(5, array.size(win)))
plot(array.sum(sl), "arr_slice_sum")
plot(array.covariance(win, win2), "arr_cov")
plot(array.percentile_nearest_rank(win, 50), "arr_pct_nearest50")
plot(array.percentile_linear_interpolation(win, 50), "arr_pct_linear50")
plot(array.percentrank(win, array.size(win) - 1), "arr_percentrank_last")
plot(array.mode(array.from(1.0, 2.0, 2.0, 3.0)), "arr_mode_const")
filled = array.new_float(3, close)
array.fill(filled, open, 1, 2)
plot(array.sum(filled), "arr_fill_sum")
plot(array.sum(array.abs(array.from(-1.0, 2.0, -3.0))), "arr_abs_sum")
arrI = array.from(3, 1, 2)
array.sort(arrI)
plot(array.get(arrI, 0) * 100 + array.get(arrI, 1) * 10 + array.get(arrI, 2), "arr_int_sorted")
plot(array.size(array.concat(array.from(1.0), array.from(2.0, 3.0))), "arr_concat_size")
rev = array.from(1.0, 2.0, 3.0)
array.reverse(rev)
plot(array.get(rev, 0), "arr_reverse0")
plot(array.pop(array.from(1.0, 2.0)), "arr_pop")
plot(array.shift(array.from(1.0, 2.0)), "arr_shift")
plot(array.remove(array.from(5.0, 6.0), 1), "arr_remove1")
m = matrix.new<float>(2, 2, 0.0)
matrix.set(m, 0, 0, close)
matrix.set(m, 0, 1, open)
matrix.set(m, 1, 0, high)
matrix.set(m, 1, 1, low)
plot(matrix.det(m), "mat_det")
plot(array.sum(matrix.row(m, 0)) + array.sum(matrix.row(m, 1)), "mat_sum")
plot(matrix.avg(m), "mat_avg")
plot(matrix.max(m), "mat_max")
plot(matrix.get(matrix.transpose(m), 0, 1), "mat_transpose01")
plot(matrix.get(matrix.mult(m, m), 0, 0), "mat_mult00")
plot(matrix.trace(m), "mat_trace")
plot(array.sum(matrix.row(m, 1)), "mat_row1_sum")
plot(matrix.rows(m) * 10 + matrix.columns(m), "mat_shape")
var mp = map.new<string, float>()
map.put(mp, str.tostring(bar_index % 5), close)
plot(map.size(mp), "map_size")
plot(map.get(mp, "0"), "map_get0")
plot(map.contains(mp, "4") ? 1 : 0, "map_contains4")
plot(array.sum(map.values(mp)), "map_values_sum")
plot(array.size(map.keys(mp)), "map_keys_size")
