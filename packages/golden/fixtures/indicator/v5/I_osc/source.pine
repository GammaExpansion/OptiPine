//@version=5
indicator("I_osc")
plot(bar_index, "bar_index")
plot(ta.rsi(close, 14), "rsi14")
plot(ta.rsi(close, 2), "rsi2")
plot(ta.rsi(hl2, 14), "rsi14_hl2")
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
plot(macdLine, "macd_line")
plot(macdSignal, "macd_signal")
plot(macdHist, "macd_hist")
plot(ta.stoch(close, high, low, 14), "stoch14")
plot(ta.sma(ta.stoch(close, high, low, 14), 3), "stoch14_k3")
plot(ta.cci(close, 20), "cci20")
plot(ta.cci(hlc3, 20), "cci20_hlc3")
plot(ta.mfi(hlc3, 14), "mfi14")
plot(ta.tsi(close, 25, 13), "tsi")
plot(ta.wpr(14), "wpr14")
plot(ta.mom(close, 10), "mom10")
plot(ta.mom(hl2, 5), "mom5_hl2")
plot(ta.roc(close, 10), "roc10")
plot(ta.change(close), "change1")
plot(ta.change(close, 3), "change3")
plot(ta.change(volume), "change_volume")
plot(ta.cog(close, 10), "cog10")
plot(ta.cmo(close, 14), "cmo14")
plot(ta.rsi(ta.rsi(close, 14), 14), "rsi_of_rsi")
plot(ta.ema(ta.rsi(close, 14), 9), "ema9_rsi14")
plot(ta.stoch(ta.rsi(close, 14), ta.rsi(close, 14), ta.rsi(close, 14), 14), "stochrsi")
[dip, dim, adx] = ta.dmi(14, 14)
plot(dip, "dmi_plus")
plot(dim, "dmi_minus")
plot(adx, "adx")
