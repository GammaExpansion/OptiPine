//@version=6
indicator("I_math_colors")
float naF = na
enc(color c) => color.r(c) * 65536 + color.g(c) * 256 + color.b(c)
plot(bar_index, "bar_index")
// ---- math.* ----
plot(math.pow(2, 0.5), "pow_2_0p5")
plot(math.sqrt(2), "sqrt_2")
plot(math.exp(1), "exp_1")
plot(math.log(math.e), "log_e")
plot(math.log10(1000), "log10_1000")
plot(math.sin(math.pi / 2), "sin_halfpi")
plot(math.cos(math.pi), "cos_pi")
plot(math.tan(math.pi / 4), "tan_quarterpi")
plot(math.asin(1), "asin_1")
plot(math.acos(-1), "acos_m1")
plot(math.atan(1), "atan_1")
plot(math.todegrees(math.pi), "todegrees_pi")
plot(math.toradians(180), "toradians_180")
plot(math.sign(-0.0), "sign_negzero")
plot(math.sign(naF), "sign_na")
plot(math.abs(-2.5), "abs_m2p5")
plot(math.ceil(-0.5), "ceil_m0p5")
plot(math.floor(0.5), "floor_0p5")
plot(math.round(-0.4), "round_m0p4")
plot(math.round(0.4999999999999999), "round_almost_half")
plot(math.round(naF), "round_na")
plot(math.avg(1, 2, 3, 4), "avg_1234")
plot(math.max(1, 2.5), "max_int_float")
plot(math.min(-1, -1.5), "min_neg")
plot(math.pow(-8, 1.0 / 3), "pow_neg_cube_root")
plot(math.sqrt(-1), "sqrt_m1")
plot(math.log(0), "log_0")
plot(math.log(-1), "log_m1")
plot(math.exp(710), "exp_710")
plot(math.pow(10, 400), "pow_10_400")
plot(1e308 * 10, "float_overflow")
plot(-1e308 * 10, "float_neg_overflow")
plot(math.random(0, 1, 42), "random_seed42_a")
plot(math.random(0, 1, 42), "random_seed42_b")
plot(math.random(0, 100, 7), "random_seed7")
plot(math.random(0, 1, 42)[1], "random_seed42_hist1")
plot(math.pi, "pi")
plot(math.e, "e")
plot(math.phi, "phi")
plot(math.rphi, "rphi")
// ---- color.* 常量与分量（v5/v6 部分常量值不同）----
plot(enc(color.red), "color_red")
plot(enc(color.green), "color_green")
plot(enc(color.blue), "color_blue")
plot(enc(color.orange), "color_orange")
plot(enc(color.gray), "color_gray")
plot(enc(color.white), "color_white")
plot(enc(color.black), "color_black")
plot(enc(color.yellow), "color_yellow")
plot(enc(color.purple), "color_purple")
plot(enc(color.aqua), "color_aqua")
plot(enc(color.lime), "color_lime")
plot(enc(color.maroon), "color_maroon")
plot(enc(color.navy), "color_navy")
plot(enc(color.olive), "color_olive")
plot(enc(color.silver), "color_silver")
plot(enc(color.teal), "color_teal")
plot(enc(color.fuchsia), "color_fuchsia")
plot(color.t(color.new(color.red, 30)), "color_t_30")
plot(color.r(#FF8000), "color_r_hex")
plot(color.g(color.rgb(1, 2, 3, 4)), "color_g_rgb")
plot(color.t(color.rgb(1, 2, 3, 4)), "color_t_rgb")
plot(enc(color.from_gradient(50, 0, 100, color.black, color.white)), "color_gradient_mid")
