//@version=6
indicator("M_time")
plot(bar_index, "bar_index")
plot(time, "time_builtin")
plot(time_close, "time_close")
plot(time_tradingday, "time_tradingday")
plot(year, "year")
plot(month, "month")
plot(dayofmonth, "dayofmonth")
plot(dayofweek, "dayofweek")
plot(hour, "hour")
plot(minute, "minute")
plot(second, "second")
plot(weekofyear, "weekofyear")
plot(hour(time, "UTC"), "hour_utc")
plot(dayofweek(time, "UTC"), "dayofweek_utc")
plot(dayofmonth(time, "UTC"), "dayofmonth_utc")
plot(hour(time, "Asia/Tokyo"), "hour_tokyo")
plot(hour(time, syminfo.timezone) - hour(time, "UTC"), "tz_offset_hours")
plot(timestamp(2024, 1, 15, 9, 30, 0), "ts_naive")
plot(timestamp("UTC", 2024, 1, 15, 9, 30), "ts_utc")
plot(timestamp("America/New_York", 2024, 1, 15, 9, 30), "ts_ny")
plot(timestamp("GMT+1", 2024, 1, 15, 9, 30), "ts_gmt1")
plot(timestamp("2024-01-15T09:30:00-05:00"), "ts_iso_offset")
plot(timestamp("2024-01-15T09:30:00"), "ts_iso_naive")
plot(timestamp("2024-01-15"), "ts_date_only")
plot(timestamp(2024, 2, 30, 0, 0), "ts_feb30")
plot(time(timeframe.period), "time_tf")
plot(time(timeframe.period, "0930-1600"), "time_session_naive")
plot(time(timeframe.period, "0930-1600", "America/New_York"), "time_session_ny")
plot(time(timeframe.period, "0000-0000:1234567", "UTC"), "time_session_utc_all")
plot(time("D"), "time_D")
plot(time_close("D"), "time_close_D")
plot(time("W"), "time_W")
plot(time("240"), "time_240")
plot(timeframe.change("D") ? 1 : 0, "tf_change_D")
plot(session.isfirstbar ? 1 : 0, "session_isfirstbar")
plot(session.islastbar ? 1 : 0, "session_islastbar")
plot(session.isfirstbar_regular ? 1 : 0, "session_isfirstbar_regular")
plot(session.islastbar_regular ? 1 : 0, "session_islastbar_regular")
plot(session.ismarket ? 1 : 0, "session_ismarket")
plot(session.ispremarket ? 1 : 0, "session_ispremarket")
plot(session.ispostmarket ? 1 : 0, "session_ispostmarket")
plot(syminfo.mintick, "syminfo_mintick")
plot(syminfo.pointvalue, "syminfo_pointvalue")
plot(syminfo.pricescale, "syminfo_pricescale")
plot(syminfo.minmove, "syminfo_minmove")
plot(str.length(syminfo.timezone), "len_syminfo_timezone")
plot(str.length(syminfo.session), "len_syminfo_session")
plot(timeframe.multiplier, "tf_multiplier")
plot(timeframe.in_seconds(), "tf_in_seconds")
plot(timeframe.isintraday ? 1 : 0, "tf_isintraday")
plot(timeframe.isdaily ? 1 : 0, "tf_isdaily")
plot(timeframe.isdwm ? 1 : 0, "tf_isdwm")
plot(str.length(timeframe.period), "len_tf_period")
plot(str.tonumber(timeframe.period), "tonumber_tf_period")
plot(last_bar_index, "last_bar_index")
plot(last_bar_time, "last_bar_time")
plot(barstate.isfirst ? 1 : 0, "isfirst")
plot(barstate.islast ? 1 : 0, "islast")
plot(barstate.isconfirmed ? 1 : 0, "isconfirmed")
plot(barstate.ishistory ? 1 : 0, "ishistory")
plot(barstate.islastconfirmedhistory ? 1 : 0, "islastconfirmedhistory")
plot(ta.change(time) / 1000, "bar_gap_seconds")
plot(str.length(str.format_time(time, "yyyy-MM-dd HH:mm", syminfo.timezone)), "len_format_time")
