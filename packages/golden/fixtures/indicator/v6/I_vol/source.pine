//@version=6
indicator("I_vol")
plot(bar_index, "bar_index")
plot(ta.tr, "tr_var")
plot(ta.tr(true), "tr_handle_na")
plot(ta.tr(false), "tr_no_handle")
plot(ta.atr(14), "atr14")
plot(ta.atr(1), "atr1")
plot(ta.atr(50), "atr50")
plot(ta.rma(ta.tr(true), 14), "rma14_tr")
plot(ta.stdev(close, 20), "stdev20")
plot(ta.stdev(close, 20, false), "stdev20_unbiased")
plot(ta.stdev(hl2, 10), "stdev10_hl2")
plot(ta.variance(close, 20), "variance20")
plot(ta.variance(close, 20, false), "variance20_unbiased")
plot(ta.dev(close, 20), "dev20")
[bbBasis, bbUpper, bbLower] = ta.bb(close, 20, 2)
plot(bbBasis, "bb_basis")
plot(bbUpper, "bb_upper")
plot(bbLower, "bb_lower")
plot(ta.bbw(close, 20, 2), "bbw")
plot(ta.bbw(close, 20, 2.5), "bbw_2p5")
[kcBasis, kcUpper, kcLower] = ta.kc(close, 20, 2)
plot(kcBasis, "kc_basis")
plot(kcUpper, "kc_upper")
plot(kcLower, "kc_lower")
[kcBasis2, kcUpper2, kcLower2] = ta.kc(close, 20, 2, false)
plot(kcUpper2, "kc_upper_no_tr")
plot(ta.kcw(close, 20, 2), "kcw")
[st, dir] = ta.supertrend(3, 10)
plot(st, "supertrend")
plot(dir, "supertrend_dir")
plot(ta.sar(0.02, 0.02, 0.2), "sar")
