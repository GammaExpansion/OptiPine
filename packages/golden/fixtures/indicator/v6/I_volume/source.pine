//@version=6
indicator("I_volume")
plot(bar_index, "bar_index")
plot(ta.vwap, "vwap_var")
plot(ta.vwap(close), "vwap_close")
plot(ta.vwap(hlc3, session.isfirstbar), "vwap_hlc3_session")
[vwapMid, vwapUp, vwapDn] = ta.vwap(hlc3, session.isfirstbar, 1)
plot(vwapMid, "vwap3_mid")
plot(vwapUp, "vwap3_upper")
plot(vwapDn, "vwap3_lower")
plot(ta.vwap(hlc3, dayofweek == dayofweek.monday and session.isfirstbar), "vwap_weekly_anchor")
plot(ta.obv, "obv")
plot(ta.accdist, "accdist")
plot(ta.pvt, "pvt")
plot(ta.nvi, "nvi")
plot(ta.pvi, "pvi")
plot(ta.wad, "wad")
plot(ta.wvad, "wvad")
plot(ta.iii, "iii")
plot(ta.vwma(close, 20), "vwma20")
plot(ta.mfi(hlc3, 14), "mfi14")
plot(ta.cum(volume), "cum_volume")
plot(math.sum(volume, 20), "sum20_volume")
plot(volume / ta.sma(volume, 20), "rel_volume")
