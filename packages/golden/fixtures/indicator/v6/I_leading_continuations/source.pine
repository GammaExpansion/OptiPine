//@version=6
indicator("Community leading continuations r1")

selected = false
     or bar_index % 3 == 1
     or bar_index % 3 == 2
value = not selected ? 10
     : bar_index % 3 == 1 ? 20
     : 30
localValue(flag) =>
    result = 0
    if flag
        result := 1
    result

plot(bar_index, "probe_index")
plot(selected ? 1 : 0, "selected")
plot(value, "branch")
plot(localValue(selected), "local_branch")
