{
  "name": "@pine/golden",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "import": "./dist/compare.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./calendar-import": {
      "types": "./dist/calendar-import.d.ts",
      "import": "./dist/calendar-import.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@pine/engine": "0.1.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2"
  }
}
