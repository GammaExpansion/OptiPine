{
  "name": "@pine/engine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar-api.d.ts",
      "import": "./dist/calendar-api.js"
    },
    "./report-number": {
      "types": "./dist/report-number.d.ts",
      "import": "./dist/report-number.js"
    },
    "./reporting": {
      "types": "./dist/broker/metrics.d.ts",
      "import": "./dist/broker/metrics.js"
    },
    "./trade-profit": {
      "types": "./dist/broker/trade-profit.d.ts",
      "import": "./dist/broker/trade-profit.js"
    },
    "./verification": {
      "types": "./dist/runtime/rolling-sum.d.ts",
      "import": "./dist/runtime/rolling-sum.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  }
}
